# ── Required on Vercel ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Set to your Vercel deployment URL + any custom domains (comma-separated)
# Example: myapp.vercel.app,api.mystore.com
DJANGO_ALLOWED_HOSTS=*

# Set False in production
DJANGO_DEBUG=False

# PostgreSQL connection URL (required on Vercel; omit to use SQLite locally)
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Your Next.js frontend URL(s) for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ── Admin ───────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# ── Cloudinary (required — no local fallback on Vercel) ──────────────────────
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=replace_me

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
